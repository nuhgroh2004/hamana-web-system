{
    "private": true,
    "scripts": {
        "build": "mix --production",
        "watch": "concurrently -k \"npm run watch:assets\" \"browser-sync start --config bs-config.js\"",
        "watch:assets": "chokidar \"resources/css/**/*.css\" \"resources/js/**/*.js\" -c \"npm run build\" --initial --debounce 500"
    },
    "devDependencies": {
        "@tailwindcss/postcss": "^4.0.0",
        "axios": "^1.7.4",
        "browser-sync": "^3.0.4",
        "chokidar-cli": "^3.0.0",
        "concurrently": "^9.0.1",
        "laravel-mix": "^6.0.49",
        "tailwindcss": "^4.0.0",
        "webpack": "5.94.0",
        "webpack-cli": "5.1.4"
    }
}
